---
import Icon from './Icon.astro';
import { site } from '../site';
---

<section id="contact" class="cta" aria-labelledby="cta-title">
  <span class="cta-icon"><Icon name="terminal" size={22} /></span>
  <p class="eyebrow">Let's build something</p>
  <h2 id="cta-title" class="display">
    <span class="line">Want a website</span>
    <span class="line faded">of your own?</span>
  </h2>
  <p class="cta-text">
    Let's connect and build something great. I'm also open to cool AI projects.
  </p>
  <div class="cta-bar">
    <span class="cta-prompt" aria-hidden="true">&gt;</span>
    <span class="cta-email">{site.email}</span>
    <a class="btn btn-primary" href={`mailto:${site.email}`}>
      Email me <span aria-hidden="true">↗</span>
    </a>
  </div>
  <p class="cta-links">
    <a href={site.links.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a>
    <a href={site.links.github} target="_blank" rel="me noopener">GitHub ↗</a>
  </p>
</section>
