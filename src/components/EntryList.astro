---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'writings'>[];
}

const { entries } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const items = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: entry.data.type === 'note' ? (await render(entry)).Content : null,
  })),
);
---

<ol class="entries">
  {
    items.map(({ entry, Content }, i) => (
      <li class="entry">
        <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
        <div class="entry-main">
          <div class="tags">
            <span class="tag tag-accent">{entry.data.type === 'note' ? 'Note' : 'Reflection'}</span>
            {entry.data.source && <span class="tag">{entry.data.source}</span>}
          </div>
          {Content ? (
            <blockquote class="entry-note">
              <Content />
            </blockquote>
          ) : (
            <>
              <h3 class="entry-title">
                <a href={`/writings/${entry.id}/`}>{entry.data.title}</a>
              </h3>
              {entry.data.description && <p class="entry-desc">{entry.data.description}</p>}
            </>
          )}
        </div>
        <time class="entry-date" datetime={entry.data.date.toISOString().slice(0, 10)}>
          {fmt.format(entry.data.date)}
        </time>
      </li>
    ))
  }
</ol>
