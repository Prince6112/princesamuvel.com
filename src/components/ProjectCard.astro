---
import { existsSync } from 'node:fs';
import type { Project } from '../site';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Only show the screenshot if the file is actually in the public folder.
const hasImage = project.image ? existsSync(`./public${project.image}`) : false;
---

<article class="card">
  {
    hasImage && (
      <img
        class="card-shot"
        src={project.image}
        alt={`Screenshot of the ${project.title} website`}
        loading="lazy"
      />
    )
  }
  <div class="card-top">
    <span class="kind">{project.kind}</span>
    {project.status && <span class="status">{project.status}</span>}
  </div>
  <h3>{project.title}</h3>
  <p>{project.summary}</p>
  {
    project.points.length > 0 && (
      <ul>
        {project.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }
  {
    project.url && (
      <a class="card-link" href={project.url} target="_blank" rel="noopener">
        {project.linkLabel ?? 'Visit'} →
      </a>
    )
  }
</article>
