---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Cta from '../components/Cta.astro';
import { site } from '../site';
---

<Base title="About" description="About Prince Samuvel.">
  <div class="wrap">
    <header class="page-head">
      <SectionHead level="h1" label="About" title="About me" />
    </header>

    <div class="split" style="padding-top: 0">
      <div class="prose">
        <p>
          I'm Prince, a data scientist in healthcare, based in Pune. Outside of work I build
          websites for small businesses and write.
        </p>
        <p>
          This site started with Matthew 25. Each servant in that parable was trusted with
          something and asked to be faithful with it. Building for the web and writing are what I
          have been given, so this is where I put them to use.
        </p>
        <p>
          <a class="mono-link strong" href="/writings/faithful-with-the-talent/">
            Read the longer version <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <dl class="facts" style="margin-top: 0">
        <div>
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Day job</dt>
          <dd>Data scientist in healthcare</dd>
        </div>
        <div>
          <dt>On the side</dt>
          <dd>Websites, local ads, and writing</dd>
        </div>
        <div>
          <dt>Toolkit</dt>
          <dd>{site.toolkit.join(' · ')}</dd>
        </div>
        <div>
          <dt>Find me</dt>
          <dd>
            <a href={`mailto:${site.email}`}>{site.email}</a>{' · '}
            <a href={site.links.linkedin} target="_blank" rel="me noopener">LinkedIn</a>{' · '}
            <a href={site.links.github} target="_blank" rel="me noopener">GitHub</a>
          </dd>
        </div>
        {
          site.resume && (
            <div>
              <dt>Résumé</dt>
              <dd>
                <a href={site.resume}>Download (PDF)</a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    <Cta />
  </div>
</Base>
