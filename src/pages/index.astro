---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Cta from '../components/Cta.astro';
import { site, websites, marketing } from '../site';
import { getWritings } from '../writings';

const latest = (await getWritings()).slice(0, 3);
const featured = [...websites, ...marketing].filter((p) => p.featured);
---

<Base>
  <section class="hero">
    <p class="eyebrow">{site.location}</p>
    <h1>Hi, I'm Prince.</h1>
    <p class="lede">
      I build things for the web, and I write down what God puts on my heart. By day I'm a data
      scientist in healthcare. This is where the building and the writing live.
    </p>
    <div class="hero-links">
      <a class="button primary" href="/work/">See my work</a>
      <a class="button" href="/writings/">Read the writings</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected work</h2>
      <a class="more" href="/work/">All work →</a>
    </div>
    <div class="cards">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Latest writings</h2>
      <a class="more" href="/writings/">All writings →</a>
    </div>
    <EntryList entries={latest} />
  </section>

  <Cta />
</Base>
