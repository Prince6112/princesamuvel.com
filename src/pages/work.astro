---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LineItem from '../components/LineItem.astro';
import Cta from '../components/Cta.astro';
import { site, websites, marketing, apps } from '../site';
---

<Base title="Work" description="Websites, marketing, apps and data work by Prince Samuvel.">
  <div class="wrap">
    <header class="page-head">
      <SectionHead level="h1" label="Work" title="Things I've built" />
      <p class="page-lede">
        Websites for small businesses, local advertising, a couple of apps I use myself, and a day
        job in data science.
      </p>
    </header>

    <section class="sub-section" aria-labelledby="websites-label">
      <p id="websites-label" class="eyebrow">01 / Websites</p>
      <div class="cards">
        {
          websites.map((project, i) => (
            <ProjectCard project={project} index={i + 1} total={websites.length} detailed />
          ))
        }
      </div>
    </section>

    <section class="sub-section" aria-labelledby="marketing-label">
      <p id="marketing-label" class="eyebrow">02 / Marketing</p>
      {marketing.map((project) => <LineItem project={project} />)}
    </section>

    <section id="apps" class="sub-section" aria-labelledby="apps-label">
      <p id="apps-label" class="eyebrow">03 / Apps</p>
      <div class="cards">
        {
          apps.map((project, i) => (
            <ProjectCard project={project} index={i + 1} total={apps.length} detailed />
          ))
        }
      </div>
    </section>

    <section class="sub-section" aria-labelledby="data-label">
      <p id="data-label" class="eyebrow">04 / Data science</p>
      <div class="split" style="padding-top: 0">
        <h2 class="display">
          <span class="line">From data</span>
          <span class="line faded">to decisions<span class="dot">.</span></span>
        </h2>
        <div class="split-body">
          <p>
            I work as a data scientist in healthcare, where I build risk scoring models and answer
            business questions with data. The work is reviewed closely, so I care about analysis
            that holds up when someone checks it.
          </p>
          <p>
            I have also completed a Professional Certificate Programme in Agentic AI and
            Applications from IITM Pravartak (IIT Madras), covering RAG pipelines and multi-agent
            orchestration with LangChain, CrewAI and AutoGen.
          </p>
          {
            site.resume && (
              <a class="mono-link strong" href={site.resume}>
                Résumé (PDF) <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    <Cta />
  </div>
</Base>
