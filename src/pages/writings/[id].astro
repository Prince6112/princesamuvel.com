---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getWritings } from '../../writings';

export async function getStaticPaths() {
  const entries = await getWritings();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const kind = entry.data.type === 'note' ? 'Note' : 'Reflection';
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="wrap">
    <a class="back" href="/writings/"><span aria-hidden="true">←</span> All writings</a>
    <article class="article">
      <header class="page-head">
        <div class="tags" style="margin-bottom: 1.25rem">
          <span class="tag tag-accent">{kind}</span>
          {entry.data.source && <span class="tag">{entry.data.source}</span>}
        </div>
        <p class="article-meta">
          <time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmt.format(entry.data.date)}</time>
        </p>
        <h1 class="display">{entry.data.title}<span class="dot">.</span></h1>
        {entry.data.description && <p class="page-lede">{entry.data.description}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
    <Cta />
  </div>
</Base>
