---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getWritings } from '../../writings';

const entries = await getWritings();
---

<Base title="Writings" description="Reflections, thoughts and quotes worth keeping.">
  <header class="page-head">
    <p class="eyebrow">Writings</p>
    <h1>Thoughts worth keeping</h1>
    <p class="lede">
      Reflections from what I'm reading and hearing, and the occasional quote I don't want to
      forget.
    </p>
  </header>
  <EntryList entries={entries} />
</Base>
